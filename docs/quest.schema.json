{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://questplus.dev/schema/quest.json",
  "title": "Quest Plus quest definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "category", "icon", "title", "description", "objectives", "rewards", "progression"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "id": { "$ref": "#/$defs/identifier" },
    "category": { "$ref": "#/$defs/identifier" },
    "icon": { "$ref": "#/$defs/identifier" },
    "title": { "$ref": "#/$defs/translations" },
    "description": { "$ref": "#/$defs/translations" },
    "objectives": { "type": "array", "minItems": 0, "maxItems": 256, "items": { "$ref": "#/$defs/objective" } },
    "kind": { "enum": ["standard", "information"] },
    "acknowledgement": { "enum": ["manual", "read_only"] },
    "requires": { "$ref": "#/$defs/prerequisite" },
    "rewards": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/reward" } },
    "progression": { "enum": ["once", "repeatable", "infinite", "tiered"] },
    "objectiveMode": { "enum": ["all", "any", "sequence"] },
    "tiers": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/tier" } },
    "afterLast": { "enum": ["stop", "repeat"] },
    "cooldownSeconds": { "type": "integer", "minimum": 0, "maximum": 31536000 },
    "timeLimitSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
    "noDeath": { "type": "boolean" },
    "hidden": { "type": "boolean", "default": false },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "narrative": { "$ref": "#/$defs/translations" }
  },
  "allOf": [
    { "if": { "not": { "required": ["kind"], "properties": { "kind": { "const": "information" } } } }, "then": { "properties": { "objectives": { "minItems": 1 } } } },
    { "if": { "properties": { "kind": { "const": "information" } }, "required": ["kind"] }, "then": { "properties": { "schemaVersion": { "const": 2 }, "progression": { "const": "once" }, "objectives": { "maxItems": 0 } } } },
    { "if": { "required": ["acknowledgement"] }, "then": { "properties": { "kind": { "const": "information" } }, "required": ["kind"] } },
    { "if": { "properties": { "schemaVersion": { "const": 1 } } }, "then": { "properties": { "progression": { "const": "once" } }, "not": { "anyOf": [{ "required": ["objectiveMode"] }, { "required": ["tiers"] }, { "required": ["afterLast"] }, { "required": ["cooldownSeconds"] }, { "required": ["timeLimitSeconds"] }, { "required": ["noDeath"] }] } } },
    { "if": { "properties": { "progression": { "const": "tiered" } } }, "then": { "required": ["tiers"] } },
    { "if": { "required": ["tiers"] }, "then": { "properties": { "progression": { "const": "tiered" } } } },
    { "if": { "required": ["afterLast"] }, "then": { "properties": { "progression": { "const": "tiered" } } } }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "translations": {
      "type": "object", "required": ["en_us"], "minProperties": 1,
      "properties": { "en_us": { "type": "string", "minLength": 1, "pattern": "\\S" } },
      "patternProperties": { "^(?!en_us$).+$": { "type": "string", "minLength": 1, "pattern": "\\S" } },
      "additionalProperties": false
    },
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "event", "target", "count"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "event": { "oneOf": [
          { "enum": ["block_break", "block_place", "block_interact", "item_obtained", "item_craft", "item_smelt", "item_use", "item_consume", "fish_item", "trade", "entity_kill", "fish_entity", "tame_animal", "breed_animal", "npc_interact", "biome_visit", "structure_visit", "dimension_enter", "inventory_count", "travel_distance", "location", "player_death", "manual"] },
          { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$", "not": { "enum": ["block_break", "block_place", "block_interact", "item_obtained", "item_craft", "item_smelt", "item_use", "item_consume", "fish_item", "trade", "entity_kill", "fish_entity", "tame_animal", "breed_animal", "npc_interact", "biome_visit", "structure_visit", "dimension_enter", "inventory_count", "travel_distance", "location", "player_death", "manual"] } }
        ] },
        "target": { "type": "string", "pattern": "^#?[a-z0-9_.-]+:[a-z0-9_./-]+$" },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "text": { "$ref": "#/$defs/translations" },
        "conditions": { "$ref": "#/$defs/objectiveCondition" }
      }
    },
    "objectiveCondition": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["and"], "properties": { "and": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/objectiveCondition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["or"], "properties": { "or": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/objectiveCondition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["not"], "properties": { "not": { "$ref": "#/$defs/objectiveCondition" } } },
        { "type": "object", "additionalProperties": false, "required": ["dimension"], "properties": { "dimension": { "$ref": "#/$defs/identifier" } } },
        { "type": "object", "additionalProperties": false, "required": ["tool"], "properties": { "tool": { "$ref": "#/$defs/identifier" } } },
        { "type": "object", "additionalProperties": false, "required": ["biome"], "properties": { "biome": { "$ref": "#/$defs/identifier" } } },
        { "type": "object", "additionalProperties": false, "required": ["effect"], "properties": { "effect": { "$ref": "#/$defs/identifier" } } },
        { "type": "object", "additionalProperties": false, "required": ["healthAtMost"], "properties": { "healthAtMost": { "type": "number", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["healthAtLeast"], "properties": { "healthAtLeast": { "type": "number", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["sneaking"], "properties": { "sneaking": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["equipment"], "properties": { "equipment": { "type": "object", "additionalProperties": false, "required": ["slot", "item"], "properties": { "slot": { "enum": ["head", "chest", "legs", "feet", "mainhand", "offhand"] }, "item": { "$ref": "#/$defs/identifier" } } } } },
        { "type": "object", "additionalProperties": false, "required": ["position"], "properties": { "position": { "$ref": "#/$defs/position" } } },
        { "type": "object", "additionalProperties": false, "required": ["context"], "properties": { "context": { "type": "object", "additionalProperties": false, "required": ["key", "equals"], "properties": { "key": { "type": "string", "minLength": 1 }, "equals": { "type": ["string", "number", "boolean"] } } } } },
        { "type": "object", "minProperties": 1, "maxProperties": 1, "propertyNames": { "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" } }
      ]
    },
    "position": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": { "xMin": { "type": "number" }, "xMax": { "type": "number" }, "yMin": { "type": "number" }, "yMax": { "type": "number" }, "zMin": { "type": "number" }, "zMax": { "type": "number" } }
    },
    "prerequisite": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["and"], "properties": { "and": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/prerequisite" } } } },
        { "type": "object", "additionalProperties": false, "required": ["or"], "properties": { "or": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/prerequisite" } } } },
        { "type": "object", "additionalProperties": false, "required": ["not"], "properties": { "not": { "$ref": "#/$defs/prerequisite" } } },
        { "type": "object", "additionalProperties": false, "required": ["quest"], "properties": { "quest": { "$ref": "#/$defs/identifier" } } }
      ]
    },
    "tier": {
      "type": "object", "additionalProperties": false, "required": ["id", "threshold", "rewards"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }, "threshold": { "type": "integer", "minimum": 1, "maximum": 1000000000 }, "rewards": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/reward" } } }
    },
    "reward": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "amount"], "properties": { "type": { "const": "experience" }, "amount": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "text": { "$ref": "#/$defs/translations" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "item", "count"], "properties": { "type": { "const": "item" }, "item": { "$ref": "#/$defs/identifier" }, "count": { "type": "integer", "minimum": 1, "maximum": 2304 }, "text": { "$ref": "#/$defs/translations" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "data"], "properties": { "type": { "$ref": "#/$defs/identifier" }, "data": { "type": "object" }, "text": { "$ref": "#/$defs/translations" } } }
      ]
    }
  }
}
