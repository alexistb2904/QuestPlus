{
	"schemaVersion": 1,
	"id": "questplus",
	"version": "${version}",
	"name": "Quest Plus",
	"icon": "assets/questplus/icon.png",
	"description": "Server-authoritative JSON quest engine. Independent backend preview.",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.questplus.platform.fabric.QuestPlusFabric"
		],
		"client": [
			"dev.questplus.platform.fabric.QuestPlusFabricClient"
		],
		"jei_mod_plugin": [
			"dev.questplus.fabric.client.QuestJeiPlugin"
		]
	},
	"mixins": [
		"questplus.mixins.json",
		{
			"config": "questplus.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"java": ">=25"
	},
	"suggests": {
		"team_reborn_energy": ">=5.0.0"
	}
}
